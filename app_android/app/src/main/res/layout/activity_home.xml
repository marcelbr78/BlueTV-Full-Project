<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0a0a1a">

    <!-- ══ SIDEBAR (Coluna 1) ════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutSidebar"
        android:layout_width="160dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#05050d"
        android:paddingTop="16dp">

        <TextView
            android:id="@+id/tvAppLogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BlueTV"
            android:textColor="#FF0000"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSidebar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Botão Configurações na Sidebar -->
        <TextView
            android:id="@+id/btnConfig"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:text="⚙"
            android:textColor="#888899"
            android:textSize="24sp"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvValidadeInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#444466"
            android:textSize="10sp"
            android:gravity="center"
            android:padding="12dp"/>
    </LinearLayout>

    <!-- ══ ÁREA DE CONTEÚDO (Coluna 2 e 3) ══════════════════ -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutMainContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Lista Lateral (Categorias/Canais) -->
            <LinearLayout
                android:id="@+id/layoutListArea"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="40"
                android:orientation="vertical"
                android:background="#08081a">
                
                <!-- Abas Superiores (Horizontal) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTabs"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#05050d"/>

                <TextView
                    android:id="@+id/tvListTitle"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:background="#0a0a1a"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvContentList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"/>
            </LinearLayout>

            <!-- Preview / Detalhes -->
            <FrameLayout
                android:id="@+id/layoutPreviewArea"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="60"
                android:background="#000000">

                <com.google.android.exoplayer2.ui.StyledPlayerView
                    android:id="@+id/pvPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:use_controller="false"
                    app:resize_mode="fill"/>

                <ImageView
                    android:id="@+id/ivPreviewLogo"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="100dp"
                    android:alpha="0.3"
                    android:scaleType="fitCenter"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:padding="32dp"
                    android:orientation="vertical"
                    android:background="#AA000000">
                    
                    <TextView
                        android:id="@+id/tvSelectedTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#ffffff"
                        android:textSize="24sp"
                        android:textStyle="bold"/>
                        
                    <TextView
                        android:id="@+id/tvSelectedEpg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FF0000"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"/>
                        
                    <TextView
                        android:id="@+id/btnActionPlay"
                        android:layout_width="180dp"
                        android:layout_height="48dp"
                        android:text="ASSISTIR"
                        android:textColor="#ffffff"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="#FF0000"
                        android:layout_marginTop="20dp"
                        android:focusable="true"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FF0000"
            android:visibility="gone"/>
    </FrameLayout>

</LinearLayout>
