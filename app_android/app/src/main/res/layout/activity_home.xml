<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0a0a1a">

    <!-- ══ COLUNA 1: SIDEBAR (Menu Principal) ════════════════ -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="160dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#05050d"
        android:paddingTop="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BlueTV"
            android:textColor="#1565C0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSidebar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvExpira"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#444466"
            android:textSize="10sp"
            android:gravity="center"
            android:padding="12dp"/>
    </LinearLayout>

    <!-- ══ COLUNA 2: CATEGORIAS / GRUPOS (Estilo UniTV) ══════ -->
    <LinearLayout
        android:id="@+id/layoutCategories"
        android:layout_width="180dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#08081a"
        android:paddingTop="12dp">
        
        <TextView
            android:id="@+id/tvCatTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GRUPOS"
            android:textColor="#1565C0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:layout_marginBottom="12dp"
            android:alpha="0.6"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- ══ COLUNA 3: CONTEÚDO (Canais / Filmes / Grid) ═══════ -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Lista Principal -->
            <LinearLayout
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#0a0a1a">
                
                <TextView
                    android:id="@+id/tvTitleContent"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Todos"
                    android:textColor="#ffffff"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:background="#05050d"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"/>
            </LinearLayout>

            <!-- Preview / Player Lateral -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#000000">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    
                    <ImageView
                        android:id="@+id/ivSelectedLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:alpha="0.2"/>
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:padding="32dp"
                        android:orientation="vertical"
                        android:background="#CC000000">
                        
                        <TextView
                            android:id="@+id/tvSelectedName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#ffffff"
                            android:textSize="24sp"
                            android:textStyle="bold"/>
                            
                        <TextView
                            android:id="@+id/tvSelectedDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#4499FF"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp"/>
                            
                        <TextView
                            android:id="@+id/btnWatchNow"
                            android:layout_width="180dp"
                            android:layout_height="48dp"
                            android:text="▶  ASSISTIR"
                            android:textColor="#ffffff"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="#1565C0"
                            android:layout_marginTop="20dp"
                            android:focusable="true"
                            android:visibility="gone"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
